//@version=6
indicator("Layered SMA Cascade + Ribbon Twist Detector", overlay = true, max_labels_count = 500)

// === SMA定義 ===
sma5  = ta.sma(close, 5)
sma20 = ta.sma(close, 20)
sma75 = ta.sma(close, 75)

// 上位Ribbon（200/400/600/800）
sma200 = ta.sma(close, 200)
sma400 = ta.sma(close, 400)
sma600 = ta.sma(close, 600)
sma800 = ta.sma(close, 800)

// === Layer定義 ===
layer1_gc = ta.crossover(sma20, sma75)   // Layer1: 20/75 GC
layer1_dc = ta.crossunder(sma20, sma75)
layer2_gc = ta.crossover(sma5, sma20)    // Layer2: 5/20 GC
layer2_dc = ta.crossunder(sma5, sma20)
layer3_gc = ta.crossover(close, sma5)    // Layer3: Price vs 5SMA
layer3_dc = ta.crossunder(close, sma5)

// === 同時重なり検知（直近3バー以内に複数Layer発生） ===
recent_layer1 = ta.barssince(layer1_gc) <= 3 or ta.barssince(layer1_dc) <= 3
recent_layer2 = ta.barssince(layer2_gc) <= 3 or ta.barssince(layer2_dc) <= 3
recent_layer3 = ta.barssince(layer3_gc) <= 3 or ta.barssince(layer3_dc) <= 3
all_layers_aligned = recent_layer1 and recent_layer2 and recent_layer3

// === 上位Ribbonねじれ検知 ===
ribbon_up   = sma200 > sma400 and sma400 > sma600 and sma600 > sma800
ribbon_down = sma200 < sma400 and sma400 < sma600 and sma600 < sma800
ribbon_tangled = not ribbon_up and not ribbon_down  // 順序崩れ or 絡み

// === プロット（SMA本体） ===
plot(sma5,  "SMA5",  color.white,  2)
plot(sma20, "SMA20", color.red, 2)
plot(sma75, "SMA75", color.blue, 2)
plot(sma200, "200", color.new(color.yellow, 0), 1)
plot(sma400, "400", color.new(color.lime, 0), 1)
plot(sma600, "600", color.new(color.teal, 0), 1)
plot(sma800, "800", color.new(color.aqua, 0), 1)

// === Layer視覚化（形状） ===
plotshape(layer1_gc, title="Layer1 GC", style=shape.triangleup,   location=location.belowbar, color=color.blue,   size=size.small, text="L1")
plotshape(layer1_dc, title="Layer1 DC", style=shape.triangledown, location=location.abovebar, color=color.blue,   size=size.small, text="L1↓")
plotshape(layer2_gc, title="Layer2 GC", style=shape.circle,       location=location.belowbar, color=color.orange, size=size.small, text="L2")
plotshape(layer2_dc, title="Layer2 DC", style=shape.circle,       location=location.abovebar, color=color.orange, size=size.small, text="L2↓")
plotshape(layer3_gc, title="Layer3 GC", style=shape.labelup,      location=location.belowbar, color=color.green,  size=size.small, text="ENTRY")
plotshape(layer3_dc, title="Layer3 DC", style=shape.labeldown,    location=location.abovebar, color=color.green,  size=size.small, text="EXIT")

// === 同時重なり強調 ===
bgcolor(all_layers_aligned ? color.new(color.yellow, 75) : na, title="All Layers Aligned!")
label.new(bar_index, high, all_layers_aligned ? "LOW LOT / SCALP MODE" : na, 
     color=color.yellow, textcolor=color.black, style=label.style_label_down, size=size.normal)

// === 上位Ribbonねじれ警告 ===
bgcolor(ribbon_tangled ? color.new(color.red, 85) : na, title="Ribbon Twist Warning")
label.new(bar_index, low, ribbon_tangled ? "RIBBON TWIST! NO ENTRY" : na, 
     color=color.red, textcolor=color.white, style=label.style_label_up, size=size.large)

// === 進行状況ラベル（バー最後に表示） ===
var string status = "Waiting..."
if layer1_gc or layer1_dc
    status := "Layer1 OK"
if layer2_gc or layer2_dc
    status := "Layer2 Accelerating"
if layer3_gc or layer3_dc
    status := "Layer3 Trigger Ready"
if all_layers_aligned
    status := "ALL LAYERS ALIGNED!"

label.new(bar_index, na, status, xloc=xloc.bar_index, yloc=yloc.price, 
     color=color.new(color.gray, 80), textcolor=color.white, size=size.tiny, style=label.style_label_left)
